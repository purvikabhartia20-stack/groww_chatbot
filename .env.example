# ============================================================
# Environment Variables — Mutual Fund FAQ Assistant
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Groq API key (required for Phase 4 LLM generation)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=gsk_...your-key-here...

# Optional: override default model from config.py
# Available Groq models: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768, gemma2-9b-it
# LLM_MODEL=llama3-8b-8192

# NOTE: No OpenAI key needed.
# Embeddings are generated locally via sentence-transformers (all-MiniLM-L6-v2).

# Optional: Pinecone (Phase 3 production vector store)
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX_NAME=hdfc-mutual-fund-corpus

# Optional: API server settings
# API_HOST=0.0.0.0
# API_PORT=8000
